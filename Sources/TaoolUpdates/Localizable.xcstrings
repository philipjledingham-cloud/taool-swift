    "whatsNew.update" : {
      "comment" : "The bar under a What's New page when this build is older than the page's version. %@ is the version.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدّث إلى الإصدار %@ للحصول على الميزات الجديدة."
          }
        },
        "ca" : {
