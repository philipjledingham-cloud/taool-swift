    "unsupported.messageIOS" : {
      "comment" : "%1$@ is the app's name, %2$@ iOS, iPadOS or visionOS, %3$@ the OS version the app needs. Settings is the Settings app's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعد هذا الإصدار من %1$@ مدعومًا، ويتطلب الإصدار الحالي %2$@ %3$@ أو أحدث. قم بتحديث %2$@ من الإعدادات لمتابعة استخدام %1$@."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta versió de %1$@ ja no és compatible i la versió actual requereix %2$@ %3$@ o posterior. Actualitza %2$@ a Configuració per continuar utilitzant %1$@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato verze aplikace %1$@ už není podporovaná a aktuální verze vyžaduje %2$@ %3$@ nebo novější. Aktualizujte %2$@ v Nastavení, abyste mohli aplikaci %1$@ dál používat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne version af %1$@ understøttes ikke længere, og den nyeste version kræver %2$@ %3$@ eller nyere. Opdater %2$@ i Indstillinger for at blive ved med at bruge %1$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Version von %1$@ wird nicht mehr unterstützt, und die aktuelle Version benötigt %2$@ %3$@ oder neuer. Aktualisiere %2$@ in den Einstellungen, um %1$@ weiter zu nutzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η έκδοση της εφαρμογής %1$@ δεν υποστηρίζεται πλέον και η τρέχουσα έκδοση απαιτεί %2$@ %3$@ ή νεότερη έκδοση. Ενημερώστε το %2$@ στις Ρυθμίσεις για να συνεχίσετε να χρησιμοποιείτε την εφαρμογή %1$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This version of %1$@ is no longer supported, and the current version needs %2$@ %3$@ or later. Update %2$@ in Settings to keep using %1$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión de %1$@ ya no es compatible y la versión actual requiere %2$@ %3$@ o posterior. Actualiza %2$@ en Ajustes para seguir usando %1$@."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión de %1$@ ya no es compatible y la versión actual requiere %2$@ %3$@ o posterior. Actualiza %2$@ en Configuración para seguir usando %1$@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: tätä versiota ei enää tueta, ja uusin versio vaatii käyttöjärjestelmän %2$@ %3$@ tai uudemman. Päivitä %2$@ Asetuksissa, jotta voit jatkaa käyttöä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version de %1$@ n’est plus prise en charge, et la version actuelle nécessite %2$@ %3$@ ou ultérieur. Mettez à jour %2$@ dans Réglages pour continuer à utiliser %1$@."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version de %1$@ n’est plus prise en charge, et la version actuelle nécessite %2$@ %3$@ ou une version ultérieure. Mettez à jour %2$@ dans Réglages pour continuer à utiliser %1$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גרסה זו של %1$@ כבר אינה נתמכת, והגרסה הנוכחית דורשת %2$@ %3$@ ואילך. יש לעדכן את %2$@ ב״הגדרות״ כדי להמשיך להשתמש ב-%1$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ का यह संस्करण अब समर्थित नहीं है, और वर्तमान संस्करण के लिए %2$@ %3$@ या बाद का संस्करण आवश्यक है। %1$@ का उपयोग जारी रखने के लिए सेटिंग्ज़ में %2$@ अपडेट करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova verzija aplikacije %1$@ više nije podržana, a trenutačna verzija zahtijeva %2$@ %3$@ ili noviji. Ažurirajte %2$@ u Postavkama kako biste nastavili upotrebljavati aplikaciju %1$@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: ez a verzió már nem támogatott, a legújabb verzióhoz pedig %2$@ %3$@ vagy újabb szükséges. A további használathoz frissítse a rendszert (%2$@) a Beállításokban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versi %1$@ ini tidak lagi didukung, dan versi terbaru memerlukan %2$@ %3$@ atau lebih baru. Perbarui %2$@ di Pengaturan untuk terus menggunakan %1$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa versione di %1$@ non è più supportata e la versione attuale richiede %2$@ %3$@ o versioni successive. Aggiorna %2$@ in Impostazioni per continuare a usare %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバージョンの%1$@はサポートされなくなりました。最新バージョンには%2$@ %3$@以降が必要です。%1$@を引き続き使用するには、“設定”で%2$@をアップデートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 버전의 %1$@은(는) 더 이상 지원되지 않으며, 최신 버전을 사용하려면 %2$@ %3$@ 이상이 필요합니다. %1$@을(를) 계속 사용하려면 설정에서 %2$@을(를) 업데이트하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versi %1$@ ini tidak lagi disokong dan versi semasa memerlukan %2$@ %3$@ atau lebih baharu. Kemas kini %2$@ dalam Seting untuk terus menggunakan %1$@."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne versjonen av %1$@ støttes ikke lenger, og den nyeste versjonen krever %2$@ %3$@ eller nyere. Oppdater %2$@ i Innstillinger for å fortsette å bruke %1$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze versie van %1$@ wordt niet meer ondersteund en de huidige versie vereist %2$@ %3$@ of nieuwer. Werk %2$@ bij in Instellingen om %1$@ te blijven gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta wersja aplikacji %1$@ nie jest już obsługiwana, a aktualna wersja wymaga systemu %2$@ %3$@ lub nowszego. Uaktualnij system %2$@ w Ustawieniach, aby nadal korzystać z aplikacji %1$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versão de %1$@ não é mais compatível, e a versão atual requer o %2$@ %3$@ ou posterior. Atualize o %2$@ em Ajustes para continuar usando o app."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versão de %1$@ já não é suportada e a versão atual requer o %2$@ %3$@ ou posterior. Atualize o %2$@ nas Definições para continuar a utilizar a app."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această versiune a aplicației %1$@ nu mai este acceptată, iar versiunea actuală necesită %2$@ %3$@ sau ulterior. Actualizați %2$@ în Configurări pentru a folosi în continuare %1$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта версия приложения «%1$@» больше не поддерживается, а для текущей версии требуется %2$@ %3$@ или новее. Обновите %2$@ в Настройках, чтобы продолжить пользоваться приложением."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Táto verzia aplikácie %1$@ už nie je podporovaná a aktuálna verzia vyžaduje %2$@ %3$@ alebo novší. Aktualizujte %2$@ v Nastaveniach, aby ste mohli aplikáciu %1$@ ďalej používať."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här versionen av %1$@ stöds inte längre, och den senaste versionen kräver %2$@ %3$@ eller senare. Uppdatera %2$@ i Inställningar för att fortsätta använda %1$@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่รองรับ %1$@ เวอร์ชั่นนี้แล้ว และเวอร์ชั่นปัจจุบันต้องใช้ %2$@ %3$@ ขึ้นไป อัปเดต %2$@ ในการตั้งค่าเพื่อใช้งาน %1$@ ต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ uygulamasının bu sürümü artık desteklenmiyor ve güncel sürüm %2$@ %3$@ veya sonrasını gerektiriyor. %1$@ uygulamasını kullanmaya devam etmek için Ayarlar’da %2$@ güncellemesini yapın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця версія програми «%1$@» більше не підтримується, а для поточної версії потрібна система %2$@ %3$@ або новіша. Оновіть %2$@ у Параметрах, щоб і далі користуватися програмою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiên bản này của %1$@ không còn được hỗ trợ và phiên bản hiện tại yêu cầu %2$@ %3$@ trở lên. Hãy cập nhật %2$@ trong Cài đặt để tiếp tục sử dụng %1$@."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本的「%1$@」已不再支援，而最新版本需要 %2$@ %3$@ 或以上版本。請前往「設定」更新 %2$@ 以繼續使用「%1$@」。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本的“%1$@”已不再受支持，且最新版本需要 %2$@ %3$@ 或更高版本。请在“设置”中更新 %2$@ 以继续使用“%1$@”。"
          }
