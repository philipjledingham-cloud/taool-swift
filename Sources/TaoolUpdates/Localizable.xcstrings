    "unsupported.messageMac" : {
      "comment" : "%1$@ is the app's name, %2$@ the macOS version the app needs. System Settings is the app's name on the Mac.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعد هذا الإصدار من %1$@ مدعومًا، ويتطلب الإصدار الحالي macOS %2$@ أو أحدث. قم بتحديث macOS من إعدادات النظام لمتابعة استخدام %1$@."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta versió de %1$@ ja no és compatible i la versió actual requereix macOS %2$@ o posterior. Actualitza macOS a Configuració del Sistema per continuar utilitzant %1$@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato verze aplikace %1$@ už není podporovaná a aktuální verze vyžaduje macOS %2$@ nebo novější. Aktualizujte macOS v Nastavení systému, abyste mohli aplikaci %1$@ dál používat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne version af %1$@ understøttes ikke længere, og den nyeste version kræver macOS %2$@ eller nyere. Opdater macOS i Systemindstillinger for at blive ved med at bruge %1$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Version von %1$@ wird nicht mehr unterstützt, und die aktuelle Version benötigt macOS %2$@ oder neuer. Aktualisiere macOS in den Systemeinstellungen, um %1$@ weiter zu nutzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η έκδοση της εφαρμογής %1$@ δεν υποστηρίζεται πλέον και η τρέχουσα έκδοση απαιτεί macOS %2$@ ή νεότερη έκδοση. Ενημερώστε το macOS στις Ρυθμίσεις συστήματος για να συνεχίσετε να χρησιμοποιείτε την εφαρμογή %1$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This version of %1$@ is no longer supported, and the current version needs macOS %2$@ or later. Update macOS in System Settings to keep using %1$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión de %1$@ ya no es compatible y la versión actual requiere macOS %2$@ o posterior. Actualiza macOS en Ajustes del Sistema para seguir usando %1$@."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión de %1$@ ya no es compatible y la versión actual requiere macOS %2$@ o posterior. Actualiza macOS en Configuración del Sistema para seguir usando %1$@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: tätä versiota ei enää tueta, ja uusin versio vaatii käyttöjärjestelmän macOS %2$@ tai uudemman. Päivitä macOS Järjestelmäasetuksissa, jotta voit jatkaa käyttöä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version de %1$@ n’est plus prise en charge, et la version actuelle nécessite macOS %2$@ ou ultérieur. Mettez à jour macOS dans Réglages Système pour continuer à utiliser %1$@."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version de %1$@ n’est plus prise en charge, et la version actuelle nécessite macOS %2$@ ou une version ultérieure. Mettez à jour macOS dans Réglages système pour continuer à utiliser %1$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גרסה זו של %1$@ כבר אינה נתמכת, והגרסה הנוכחית דורשת macOS %2$@ ואילך. יש לעדכן את macOS ב״הגדרות המערכת״ כדי להמשיך להשתמש ב-%1$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ का यह संस्करण अब समर्थित नहीं है, और वर्तमान संस्करण के लिए macOS %2$@ या बाद का संस्करण आवश्यक है। %1$@ का उपयोग जारी रखने के लिए सिस्टम सेटिंग्ज़ में macOS अपडेट करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova verzija aplikacije %1$@ više nije podržana, a trenutačna verzija zahtijeva macOS %2$@ ili noviji. Ažurirajte macOS u Postavkama sustava kako biste nastavili upotrebljavati aplikaciju %1$@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: ez a verzió már nem támogatott, a legújabb verzióhoz pedig macOS %2$@ vagy újabb szükséges. A további használathoz frissítse a macOS-t a Rendszerbeállításokban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versi %1$@ ini tidak lagi didukung, dan versi terbaru memerlukan macOS %2$@ atau lebih baru. Perbarui macOS di Pengaturan Sistem untuk terus menggunakan %1$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa versione di %1$@ non è più supportata e la versione attuale richiede macOS %2$@ o versioni successive. Aggiorna macOS in Impostazioni di Sistema per continuare a usare %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバージョンの%1$@はサポートされなくなりました。最新バージョンにはmacOS %2$@以降が必要です。%1$@を引き続き使用するには、“システム設定”でmacOSをアップデートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 버전의 %1$@은(는) 더 이상 지원되지 않으며, 최신 버전을 사용하려면 macOS %2$@ 이상이 필요합니다. %1$@을(를) 계속 사용하려면 시스템 설정에서 macOS를 업데이트하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versi %1$@ ini tidak lagi disokong dan versi semasa memerlukan macOS %2$@ atau lebih baharu. Kemas kini macOS dalam Seting Sistem untuk terus menggunakan %1$@."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne versjonen av %1$@ støttes ikke lenger, og den nyeste versjonen krever macOS %2$@ eller nyere. Oppdater macOS i Systeminnstillinger for å fortsette å bruke %1$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze versie van %1$@ wordt niet meer ondersteund en de huidige versie vereist macOS %2$@ of nieuwer. Werk macOS bij in Systeeminstellingen om %1$@ te blijven gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta wersja aplikacji %1$@ nie jest już obsługiwana, a aktualna wersja wymaga systemu macOS %2$@ lub nowszego. Uaktualnij system macOS w Ustawieniach systemowych, aby nadal korzystać z aplikacji %1$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versão de %1$@ não é mais compatível, e a versão atual requer o macOS %2$@ ou posterior. Atualize o macOS em Ajustes do Sistema para continuar usando o app."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versão de %1$@ já não é suportada e a versão atual requer o macOS %2$@ ou posterior. Atualize o macOS nas Definições do Sistema para continuar a utilizar a app."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această versiune a aplicației %1$@ nu mai este acceptată, iar versiunea actuală necesită macOS %2$@ sau ulterior. Actualizați macOS în Configurări sistem pentru a folosi în continuare %1$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта версия приложения «%1$@» больше не поддерживается, а для текущей версии требуется macOS %2$@ или новее. Обновите macOS в Системных настройках, чтобы продолжить пользоваться приложением."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Táto verzia aplikácie %1$@ už nie je podporovaná a aktuálna verzia vyžaduje macOS %2$@ alebo novší. Aktualizujte macOS v Systémových nastaveniach, aby ste mohli aplikáciu %1$@ ďalej používať."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här versionen av %1$@ stöds inte längre, och den senaste versionen kräver macOS %2$@ eller senare. Uppdatera macOS i Systeminställningar för att fortsätta använda %1$@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่รองรับ %1$@ เวอร์ชั่นนี้แล้ว และเวอร์ชั่นปัจจุบันต้องใช้ macOS %2$@ ขึ้นไป อัปเดต macOS ในการตั้งค่าระบบเพื่อใช้งาน %1$@ ต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ uygulamasının bu sürümü artık desteklenmiyor ve güncel sürüm macOS %2$@ veya sonrasını gerektiriyor. %1$@ uygulamasını kullanmaya devam etmek için Sistem Ayarları’nda macOS güncellemesini yapın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця версія програми «%1$@» більше не підтримується, а для поточної версії потрібна система macOS %2$@ або новіша. Оновіть macOS у Системних параметрах, щоб і далі користуватися програмою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiên bản này của %1$@ không còn được hỗ trợ và phiên bản hiện tại yêu cầu macOS %2$@ trở lên. Hãy cập nhật macOS trong Cài đặt hệ thống để tiếp tục sử dụng %1$@."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本的「%1$@」已不再支援，而最新版本需要 macOS %2$@ 或以上版本。請前往「系統設定」更新 macOS 以繼續使用「%1$@」。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本的“%1$@”已不再受支持，且最新版本需要 macOS %2$@ 或更高版本。请在“系统设置”中更新 macOS 以继续使用“%1$@”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本的「%1$@」已不再支援，且最新版本需要 macOS %2$@ 或以上版本。請前往「系統設定」更新 macOS 以繼續使用「%1$@」。"
          }
        }
      }
